# Backend baked into the iPad (Capacitor) build, mirroring .env.electron.
#
# The packaged app has no same-origin server, so this is how it finds the
# backend — see client-aac/src/lib/api-base.ts. The release workflow can
# override it per environment by exporting VITE_API_URL before the build.
# PRODUCTION. This is a fallback only — both iOS workflows pass VITE_API_URL
# explicitly (their `backend_url` input) — but a store build must never be able
# to fall through to staging, so the fallback is production too. Point a build
# at staging by setting the workflow input, not by editing this line.
VITE_API_URL="https://api.aivota.ai"
