# Backend baked into the iPad (Capacitor) build, mirroring .env.electron.
#
# The packaged app has no same-origin server, so this is how it finds the
# backend — see client-aac/src/lib/api-base.ts. The release workflow can
# override it per environment by exporting VITE_API_URL before the build.
VITE_API_URL="https://aivota-demo-us.onrender.com"
