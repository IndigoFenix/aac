events\": [{\"type\": \"onClick\"}]}, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"The student touched the pillow. Say: 'A pillow is so soft and squishy! It feels nice and cozy. You can press it and it bounces back.'\"}}]}, {\"id\": \"rock\", \"label\": \"Rock\", \"iconRef\": \"🪨\", \"imageKey\": \"rock\", \"tileColor\": \"#d4c5b9\", \"size\": [1, 1], \"layer\": \"entity\", \"char\": \"R\", \"movable\": true, \"types\": [\"hard\", \"cool\"], \"interactions\": [{\"triggers\": {\"events\": [{\"type\": \"onClick\"}]}, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"The student touched the rock. Say: 'A rock is hard and solid. It doesn't change shape. Can you feel how strong and sturdy it is?'\"}}]}, {\"id\": \"sponge\", \"label\": \"Sponge\", \"iconRef\": \"🧽\", \"imageKey\": \"sponge\", \"tileColor\": \"#fff9e6\", \"size\": [1, 1], \"layer\": \"entity\", \"char\": \"S\", \"movable\": true, \"types\": [\"soft\", \"cool\"], \"interactions\": [{\"triggers\": {\"events\": [{\"type\": \"onClick\"}]}, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"The student touched the sponge. Say: 'A sponge is soft and squishy! It has tiny holes in it. When you squeeze it, water comes out. It's fun to squish!'\"}}]}, {\"id\": \"metal_pot\", \"label\": \"Metal Pot\", \"iconRef\": \"🍲\", \"imageKey\": \"cooking_pot\", \"tileColor\": \"#c0c0c0\", \"size\": [1, 1], \"layer\": \"entity\", \"char\": \"M\", \"movable\": true, \"types\": [\"hard\", \"cool\"], \"interactions\": [{\"triggers\": {\"events\": [{\"type\": \"onClick\"}]}, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"The student touched the metal pot. Say: 'This metal pot is hard and shiny. Metal can get very hot when we cook with it, but right now it's cool. Can you see your reflection?'\"}}]}, {\"id\": \"cold_zone\", \"label\": \"Cold Area\", \"iconRef\": \"❄️\", \"tileColor\": \"#b3e5fc\", \"size\": [2, 1], \"layer\": \"background\", \"char\": \"C\", \"isTile\": true, \"hidden\": false}, {\"id\": \"hot_zone\", \"label\": \"Hot Area\", \"iconRef\": \"🔥\", \"tileColor\": \"#ffccbc\", \"size\": [2, 1], \"layer\": \"background\", \"char\": \"H\", \"isTile\": true, \"hidden\": false}, {\"id\": \"soft_zone\", \"label\": \"Soft Area\", \"iconRef\": \"☁️\", \"tileColor\": \"#f3e5f5\", \"size\": [2, 1], \"layer\": \"background\", \"char\": \"O\", \"isTile\": true, \"hidden\": false}, {\"id\": \"hard_zone\", \"label\": \"Hard Area\", \"iconRef\": \"💎\", \"tileColor\": \"#efebe9\", \"size\": [2, 1], \"layer\": \"background\", \"char\": \"D\", \"isTile\": true, \"hidden\": false}], \"buttons\": [{\"id\": \"explore\", \"label\": \"Explore\", \"iconRef\": \"👀\", \"buttonColor\": \"#4CAF50\", \"enabledByDefault\": true, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"Encourage the student: 'Let's explore the materials! Touch one and tell me what you feel. Is it hot or cold? Is it hard or soft?'\"}]}, {\"id\": \"sort_game\", \"label\": \"Sort by Feel\", \"iconRef\": \"🎯\", \"buttonColor\": \"#2196F3\", \"enabledByDefault\": true, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"Start a sorting game: 'Let's sort! I'll name a property—like COLD or SOFT. You touch all the things that feel that way. Ready? Let's start with COLD!'\"}}]}, {\"id\": \"celebrate\", \"label\": \"Great Job!\", \"iconRef\": \"⭐\", \"buttonColor\": \"#FF9800\", \"enabledByDefault\": true, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"Celebrate: 'Wonderful! You're learning so much about how things feel! You're a material explorer!'\"}}]}, {\"id\": \"more_options\", \"label\": \"More Options\", \"iconRef\": \"❓\", \"buttonColor\": \"#9C27B0\", \"enabledByDefault\": true, \"effects\": [{\"type\": \"sendAiInstruction\", \"message\": \"Offer choices: 'Want to keep exploring? You could touch more materials, play the sorting game, or tell me about something you felt today!'\"}}]}, {\"id\": \"home\", \"label\": \"Home\", \"iconRef\": \"🏠\", \"buttonColor\": \"#607D8B\", \"enabledByDefault\": true, \"effects\": [{\"type\": \"setRoom\", \"id\": \"main_room\"}]}], \"rooms\": [{\"id\": \"main_room\", \"label\": \"Material Explorer\", \"size\": [6, 5], \"defaultTile\": \" \", \"tiles\": \"C C H H O O\\nI . . . . S\\nC C H H O O\\nP . . . R .\\nD D D D D D\", \"entities\": [{\"classId\": \"ice\", \"position\": [0, 1]}, {\"classId\": \"sponge\", \"position\": [5, 1]}, {\"classId\": \"pillow\", \"position\": [0, 3]}, {\"classId\": \"rock\", \"position\": [4, 3]}, {\"classId\": \"fire\", \"position\": [2, 2]}, {\"classId\": \"metal_pot\", \"position\": [3, 2]}], \"buttons\": [\"explore\", \"sort_game\", \"celebrate\", \"more_options\", \"home\"], \"aiInstructions\": \"This is the main exploration room. Materials are scattered around colored zones that hint at their properties (cold, hot, soft, hard). When the student interacts with a material, describe its properties in simple, sensory language. Celebrate discoveries and encourage them to explore more materials or try the sorting game.\"}]}}}]"
