            "chips": {
              "type": "array",
              "description": "Up to 3 chips. Replaces any prior memory chips for this category.",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Stable snake_case key."
                  },
                  "label": {
                    "type": "string",
                    "description": "Short display label (2–3 words)."
