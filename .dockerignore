# Dependencies
node_modules
npm-debug.log

# Build outputs (we'll build in Docker)
dist
build

# ...except the game bundles, which the CI runner builds and the image only
# COPYs (see Dockerfile). Building 16 games inside the image would add minutes
# to every deploy. This exception must stay BELOW the `dist` rule — in a
# .dockerignore the last matching pattern wins.
!dist/public-games

# Development files
.git
.gitignore
.env
.env.*
*.md
!README.md

# IDE
.idea
.vscode
*.swp
*.swo

# Test files
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__

# Terraform
terraform
*.tfstate
*.tfstate.*
.terraform

# Docker
Dockerfile
docker-compose*
.docker

# CI/CD
.github

# OS
.DS_Store
Thumbs.db

# Misc
*.log
*.tmp
