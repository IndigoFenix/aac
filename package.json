{
  "name": "aivota-aac",
  "version": "1.0.2",
  "type": "module",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "client:dev": "vite",
    "client-aac:dev": "vite --config vite.config.aac.ts",
    "build:client-aac": "vite build --config vite.config.aac.ts",
    "build:games": "tsx scripts/build-games.ts",
    "build": "vite build && vite build --config vite.config.aac.ts && esbuild server/index.prod.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && npm run build:games",
    "build:client": "vite build",
    "prerender:landing": "tsx scripts/prerender-landing.ts",
    "build:server:lambda": "esbuild server/index.lambda.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.prod.js",
    "check": "tsc",
    "get-ec2": "aws ssm describe-instance-information --query \"InstanceInformationList[*].InstanceId\"",
    "db-tunnel": "bash scripts/db-tunnel.sh",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:create-test": "tsx scripts/create-test-db.ts",
    "db:copy-to-prod": "tsx scripts/copy-tables-to-prod.ts",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:progress": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=progress.test.ts",
    "test:institute": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=institute.test.ts",
    "test:reports": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=reports.test.ts",
    "test:integration": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=integration",
    "test:llm": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathIgnorePatterns='/node_modules/|/dist/' --testPathPatterns=server/tests/llm/ --runInBand",
    "test:llm-mocked": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=server/tests/llm-mocked/",
    "test:ai": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathIgnorePatterns='/node_modules/|/dist/' --testPathPatterns=ai-response.test.ts --runInBand",
    "test:license": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=license.test.ts",
    "test:user": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=user.test.ts",
    "test:student": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=student.test.ts",
    "test:student-objects": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=student-objects.test.ts",
    "test:student-switching": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=student-switching.test.ts",
    "test:permissions": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=permissions.test.ts",
    "test:coverage": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:watch": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:paddle": "tsx scripts/test-paddle-sandbox.ts",
    "electron:build-main": "node electron/build.mjs",
    "sidecar:runtime": "node scripts/fetch-sidecar-runtime.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "electron:dev": "npm run sidecar:runtime && npm run electron:build-main && concurrently -n vite,electron \"npm run client-aac:dev\" \"electron .\"",
    "electron:build": "cross-env ELECTRON_BUILD=1 vite build --config vite.config.aac.ts --mode electron && npm run electron:build-main",
    "electron:package": "npm run electron:build && npm run build:sidecar && electron-builder",
    "electron:package:win": "npm run electron:build && npm run build:sidecar && electron-builder --win",
    "release:aac:build": "npm run electron:build && npm run build:sidecar && electron-builder --win --publish never",
    "release:aac:publish": "node scripts/publish-aac-release.mjs",
    "release:aac": "npm run release:aac:build && npm run release:aac:publish",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:critical": "npm audit --audit-level=critical",
    "audit:a11y": "node scripts/audit-a11y-icon-buttons.mjs",
    "lint": "eslint .",
    "lint:a11y": "eslint client/src client-aac/src",
    "audit:a11y:axe": "node scripts/audit-a11y-axe.mjs"
  },
