{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*", "../../shared/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
