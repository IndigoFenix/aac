{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*", "../popusim/src/**/*", "../../shared/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@popusim/*": ["../popusim/src/*"],
      "@cells/*": ["../../shared/world-engine/kernel/cells/*"]
    }
  }
}
